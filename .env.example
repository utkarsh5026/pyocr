# pyocr-toolkit settings. Run `pyocr init` to copy this file to .env, then fill in
# the providers you use. Providers without credentials show as "not configured".
# Keys are read by the server only; they are never sent to the browser.

# --- Claude (Anthropic API) ---------------------------------------------------
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# How much the model reasons before answering: low | medium | high | xhigh | max
# ANTHROPIC_EFFORT=medium

# --- OpenAI -------------------------------------------------------------------
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5
# OPENAI_BASE_URL=

# --- Azure OpenAI ---------------------------------------------------------------
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<a vision-capable deployment name>
# AZURE_OPENAI_API_VERSION=2024-10-21

# --- Claude on Azure (Microsoft Foundry) ------------------------------------------
ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_RESOURCE=<foundry-resource-name>
# or the full endpoint instead of the resource name:
# ANTHROPIC_FOUNDRY_BASE_URL=https://<resource>.services.ai.azure.com/anthropic
# ANTHROPIC_FOUNDRY_MODEL=claude-opus-5-5

# --- Google Gemini --------------------------------------------------------------
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Any OpenAI-compatible server: Ollama, vLLM, LM Studio, OpenRouter ----------
# OPENAI_COMPATIBLE_BASE_URL=http://localhost:11434/v1
# OPENAI_COMPATIBLE_MODEL=qwen2.5vl:7b
# OPENAI_COMPATIBLE_API_KEY=

# --- Storage, rendering and OCR ---------------------------------------------------
# DATA_DIR=data
# MAX_UPLOAD_MB=200
# PREVIEW_DPI=110
# LLM_DPI=200
# LLM_MAX_EDGE_PX=2400
# OCR_DPI=300
# TESSERACT_LANGUAGE=eng          # e.g. eng+deu (install the language packs first)
# LLM_CONCURRENCY=4
# LLM_TIMEOUT_S=300
